<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\LoanManagementSystem.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Jwt__Secret is intentionally NOT set here — it's injected as an
               IIS-level application setting after the site is created (see
               .claude/skills/deploy-to-iis), so the real secret never lands
               in a file that could get committed to source control. -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
